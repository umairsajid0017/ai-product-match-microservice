# Server
HOST=0.0.0.0
PORT=8001

# Neon Postgres + pgvector (required for Lambda / production)
DATABASE_URL=postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/everystore_product_match?sslmode=require

# SQS (set automatically by SAM; leave empty for local BackgroundTasks mode)
SQS_QUEUE_URL=
SQS_DLQ_URL=
AWS_REGION=ap-south-1

# S3 staging bucket for multipart embed uploads (set by SAM)
S3_BUCKET=

# Optional local image path (dev reindex only)
IMAGE_BASE_PATH=../orig_images

# Model
CLIP_MODEL_NAME=ViT-B-32
CLIP_PRETRAINED=openai

# Search
DEFAULT_TOP_K=10
SIMILARITY_THRESHOLD=0.70

# Security (must match Laravel PRODUCT_MATCH_API_KEY)
INTERNAL_API_KEY=your-secret-key-here
LARAVEL_CALLBACK_URL=https://backend.everystore.pk/api/internal/ai-matching/callback
